{
  "name": "engine-uring",
  "build": { "dockerfile": "Dockerfile" },
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt", "seccomp=unconfined"
  ],
  "postCreateCommand": "cmake --preset default && cmake --build --preset default",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "llvm-vs-code-extensions.vscode-clangd",
        "twxs.cmake",
        "ms-vscode.cmake-tools"
      ]
    }
  }
}
