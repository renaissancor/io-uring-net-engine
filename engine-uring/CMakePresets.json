{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Debug + ASan + UBSan (dev default)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "RelWithDebInfo + ThreadSanitizer (concurrency PRs)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "release",
      "displayName": "Release (-O2, no sanitizers)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld"
      }
    },
    {
      "name": "floor",
      "displayName": "Ubuntu 22.04 + g++-12 floor + ASan + UBSan (CI)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/floor",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++-12",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "tsan",    "configurePreset": "tsan" },
    { "name": "release", "configurePreset": "release" },
    { "name": "floor",   "configurePreset": "floor" }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true },
      "environment": { "LSAN_OPTIONS": "detect_leaks=0" }
    },
    { "name": "default-lsan", "configurePreset": "default", "output": { "outputOnFailure": true } },
    {
      "name": "default-no-lsan",
      "configurePreset": "default",
      "output": { "outputOnFailure": true },
      "environment": { "LSAN_OPTIONS": "detect_leaks=0" }
    },
    { "name": "tsan",    "configurePreset": "tsan",    "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "floor",   "configurePreset": "floor",   "output": { "outputOnFailure": true } }
  ]
}
