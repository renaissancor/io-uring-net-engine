# clangd configuration for iouring-net-lib.
# https://clangd.llvm.org/config

CompileFlags:
    Add:
        - -std=c++20
        - -Wall
        - -Wextra
        - -Wpedantic
        - -I${workspaceRoot}/include
    Compiler: clang++

Diagnostics:
    UnusedIncludes: Strict
    MissingIncludes: Strict
    ClangTidy:
        FastCheckFilter: Loose

Index:
    Background: Build

InlayHints:
    Enabled: Yes
    ParameterNames: Yes
    DeducedTypes: Yes
    Designators: Yes
    BlockEnd: No

Hover:
    ShowAKA: Yes

Completion:
    AllScopes: Yes
